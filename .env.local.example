AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=matcha-product-database

# Accounts, favorites, ratings and reviews (Supabase). The URL and publishable key are public and
# have built-in defaults in src/lib/supabase.ts; only set these to point at a different project.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: used only by scripts/moderate-reviews.mjs on your own machine. Never add it to Amplify.
# SUPABASE_SECRET_KEY=
